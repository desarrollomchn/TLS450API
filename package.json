{
  "name": "veeder-root-api",
  "version": "1.0.0",
  "description": "API para leer niveles de combustible de un Veeder-Root (TLS-3xx/4) y notificar por correo cuando el nivel esté bajo",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
