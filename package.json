    "test:email": "node src/testEmail.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.2.2",
    "mssql": "^12.7.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14"
  }
}
