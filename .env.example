# Conexión a los Veeder-Root (el host es por estación, ver comb_estaciones.Host —
# ya no se configura aquí, hay varias estaciones)
VEEDER_PORT=10001
VEEDER_TIMEOUT_MS=8000

# Cada cuánto se consulta el equipo (en minutos)
POLL_INTERVAL_MINUTES=10

# Pausa el cron de monitoreo automático (y el poll inicial al arrancar) sin apagar la API.
# POST /tanks/check-now sigue disponible para disparar una consulta manual.
MONITOR_ENABLED=true

# Umbral de alerta por defecto (en % de la capacidad del tanque), único para todas
# las estaciones — no existe (todavía) un umbral por estación/tanque en la base
DEFAULT_LOW_LEVEL_PERCENT=20

# Para no saturar de correos: horas mínimas entre alertas repetidas del mismo tanque
ALERT_COOLDOWN_HOURS=6

# --- Correo (SMTP) ---
MAIL_TO=compras@tuempresa.com

# --- API ---
API_PORT=3000

# --- Autenticación (AuthServiceApi centralizada) ---
AUTH_JWKS_URI=https://192.168.1.53:8443/.well-known/jwks.json
AUTH_ISSUER=AuthServiceApi
AUTH_AUDIENCE=tls450
# El AuthServiceApi de desarrollo usa certificado autofirmado.
# Poner en "true" SOLO en desarrollo local, nunca en producción.
AUTH_ALLOW_INSECURE_TLS=false

# Las alertas de nivel bajo (sendLowLevelAlert) se mandan vía POST /v1/correo de
# AuthServiceApi en vez de SMTP directo — CORREO_API_KEY es la que emitió ese
# servicio (header X-Api-Key), no una credencial de TLS450Api. SMTP_* de arriba
# sigue en uso solo para npm run test:email (prueba de conexión directa).
AUTH_API_BASE_URL=https://192.168.1.53:8443
CORREO_API_KEY=cambia_esto

# --- Base de datos (SQL Server, compartida con BackOfficeApi) ---
MSSQL_SERVER=changeme
MSSQL_INSTANCE=changeme
MSSQL_DATABASE=MonteCristoBO
MSSQL_USER=sa
MSSQL_PASSWORD=changeme
MSSQL_TRUST_SERVER_CERTIFICATE=true
